# =====================================================================
# SmartMove Transport Solutions - Backend Environment Configuration
# =====================================================================
# IMPORTANT: Never commit this file to git! It contains sensitive data.
# Copy .env.example to .env and fill in your actual values.
# =====================================================================

# =====================================================================
# Application Settings
# =====================================================================
NODE_ENV=development
PORT=5001
API_PREFIX=/api
LOG_LEVEL=debug

# =====================================================================
# Oracle Database Configuration
# =====================================================================
# These credentials should match your Oracle SQL Developer setup
ORACLE_USER=SYSTEM
ORACLE_PASSWORD=elisa123
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SID=FREEPDB1

# Connection Pool Settings
ORACLE_POOL_MIN=2
ORACLE_POOL_MAX=10
ORACLE_POOL_INCREMENT=1

# =====================================================================
# MongoDB Configuration
# =====================================================================
# Local MongoDB or Atlas connection
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=smartmove_mongodb
MONGO_USER=
MONGO_PASSWORD=

# Alternative: Full MongoDB URI (uncomment if using Atlas or remote)
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/smartmove_mongodb?retryWrites=true&w=majority

# =====================================================================
# CORS Settings
# =====================================================================
# Allowed origins for cross-origin requests
CORS_ORIGIN=http://localhost:3000,http://localhost:5000

# =====================================================================
# API Settings
# =====================================================================
DETAILED_LOGGING=true
REQUEST_TIMEOUT=30000

# =====================================================================
# Notes for Users
# =====================================================================
# 1. Replace ORACLE_PASSWORD with your actual Oracle password
# 2. If MongoDB is remote, use MONGO_URI instead of separate settings
# 3. Update CORS_ORIGIN for production domains
# 4. Never share this file - keep credentials private!
# 5. For production, use environment variables from your hosting platform
